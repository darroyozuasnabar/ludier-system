generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerAccountId])
}

model Project {
  id                    String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                  String
  client                String
  clientType            String?                 @default("CONSTRUCTORA")
  valorization          Float
  status                String?                 @default("ACTIVO")
  startDate             DateTime                @db.Timestamp(6)
  expectedEndDate       DateTime                @db.Timestamp(6)
  actualEndDate         DateTime?               @db.Timestamp(6)
  location              String
  description           String?
  createdAt             DateTime?               @default(now()) @db.Timestamp(6)
  updatedAt             DateTime?               @default(now()) @db.Timestamp(6)
  Alert                 Alert[]
  ConfiguracionContrato ConfiguracionContrato[]
  Contrato              Contrato[]
  CostoReal             CostoReal[]
  Hito                  Hito[]
  Trabajo               Trabajo[]
  Valorizacion          Valorizacion[]
  Cotizacion            Cotizacion[]
}

model Session {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamp(6)
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model User {
  id                    String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  email                 String                  @unique
  name                  String?
  role                  String?                 @default("OPERATIVO")
  active                Boolean?                @default(true)
  createdAt             DateTime?               @default(now()) @db.Timestamp(6)
  updatedAt             DateTime?               @default(now()) @db.Timestamp(6)
  Account               Account[]
  Session               Session[]
  Cotizacion            Cotizacion[]
  CotizacionSeguimiento CotizacionSeguimiento[]
}

model Alert {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  projectId   String?
  title       String
  description String
  priority    String
  status      String?   @default("PENDIENTE")
  createdAt   DateTime? @default(now()) @db.Timestamp(6)
  Project     Project?  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ConfiguracionContrato {
  id                String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  project_id        String?
  nombre            String
  costo_directo     Decimal   @db.Decimal(12, 2)
  garantia          Decimal   @db.Decimal(12, 2)
  total_pagar       Decimal   @db.Decimal(12, 2)
  historico_cobrado Decimal?  @default(0) @db.Decimal(12, 2)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  Project           Project?  @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Contrato {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  project_id String?
  nombre     String
  monto      Decimal   @db.Decimal(12, 2)
  fecha      DateTime  @db.Date
  estado     String?   @default("ACTIVO")
  tipo       String?   @default("CONTRATO")
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  Project    Project?  @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model CostoReal {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  projectId      String
  descripcion    String
  fecha          DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  fierro         Decimal   @default(0) @db.Decimal(12, 2)
  pintura        Decimal   @default(0) @db.Decimal(12, 2)
  galvanizado    Decimal   @default(0) @db.Decimal(12, 2)
  manoObra       Decimal   @default(0) @db.Decimal(12, 2)
  transporte     Decimal   @default(0) @db.Decimal(12, 2)
  instalacion    Decimal   @default(0) @db.Decimal(12, 2)
  desperdicio    Decimal   @default(0) @db.Decimal(12, 2)
  retrabajos     Decimal   @default(0) @db.Decimal(12, 2)
  createdAt      DateTime? @default(now()) @db.Timestamp(6)
  contratoNombre String    @default("")
  Project        Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Hito {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  project_id  String?
  title       String
  description String
  fecha       String
  badge       String
  badge_color String
  acento      String
  orden       Int?      @default(0)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  Project     Project?  @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Inventario {
  id            String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  nombre        String
  categoria     String
  cantidad      Int             @default(0)
  ubicacion     String
  unidad        String?         @default("unidades")
  stock_minimo  Int?            @default(0)
  contenido     String?
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  updated_at    DateTime?       @default(now()) @db.Timestamp(6)
  Mantenimiento Mantenimiento[]
  Prestamo      Prestamo[]
}

model Mantenimiento {
  id           String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  item_id      String?
  item_nombre  String
  tipo         String
  descripcion  String?
  fecha        DateTime    @db.Date
  fechaproximo DateTime?   @db.Date
  costo        Decimal?    @db.Decimal(10, 2)
  created_at   DateTime?   @default(now()) @db.Timestamp(6)
  Inventario   Inventario? @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Prestamo {
  id                  String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  item_id             String?
  item_nombre         String
  trabajador          String
  fechaprestamo       DateTime    @db.Date
  fechadevolucion     DateTime?   @db.Date
  fechadevolucionreal DateTime?   @db.Date
  estado              String?     @default("ACTIVO")
  observaciones       String?
  created_at          DateTime?   @default(now()) @db.Timestamp(6)
  Inventario          Inventario? @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Trabajo {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  project_id String?
  name       String
  orden      Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  Project    Project?  @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Valorizacion {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  projectId    String?
  period       String
  costoDirecto Decimal   @db.Decimal(12, 2)
  igv          Decimal   @db.Decimal(12, 2)
  totalFactura Decimal   @db.Decimal(12, 2)
  garantia     Decimal   @db.Decimal(12, 2)
  netoCobrar   Decimal   @db.Decimal(12, 2)
  avancePct    Decimal   @db.Decimal(5, 2)
  status       String?   @default("PENDIENTE")
  fechaEmision DateTime  @db.Timestamp(6)
  fechaCobro   DateTime? @db.Timestamp(6)
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  notas        String?
  Project      Project?  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Worker {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  role      String
  location  String
  active    Boolean?  @default(true)
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
}

model Cotizacion {
  id                String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  numero            String                  @unique
  project_id        String?
  cliente           String
  cliente_ruc       String?
  cliente_contacto  String?
  cliente_telefono  String?
  cliente_email     String?
  cliente_direccion String?
  fecha_emision     DateTime                @default(dbgenerated("CURRENT_DATE")) @db.Date
  fecha_validez     DateTime?               @db.Date
  estado            String                  @default("BORRADOR")
  subtotal          Decimal                 @default(0) @db.Decimal(12, 2)
  igv               Decimal                 @default(0) @db.Decimal(12, 2)
  total             Decimal                 @default(0) @db.Decimal(12, 2)
  moneda            String                  @default("PEN")
  tipo_cambio       Decimal?                @db.Decimal(8, 3)
  condiciones       String?
  notas             String?
  creado_por        String?
  fecha_envio       DateTime?               @db.Timestamp(6)
  fecha_aprobacion  DateTime?               @db.Timestamp(6)
  fecha_conversion  DateTime?               @db.Timestamp(6)
  created_at        DateTime?               @default(now()) @db.Timestamp(6)
  updated_at        DateTime?               @default(now()) @db.Timestamp(6)
  Creador           User?                   @relation(fields: [creado_por], references: [id], onDelete: SetNull, onUpdate: NoAction)
  Project           Project?                @relation(fields: [project_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items             CotizacionItem[]
  seguimientos      CotizacionSeguimiento[]
}

model CotizacionItem {
  id              String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  cotizacion_id   String
  descripcion     String
  cantidad        Decimal    @db.Decimal(10, 2)
  unidad          String
  precio_unitario Decimal    @db.Decimal(12, 2)
  descuento       Decimal?   @default(0) @db.Decimal(12, 2)
  total           Decimal    @db.Decimal(12, 2)
  orden           Int?       @default(0)
  created_at      DateTime?  @default(now()) @db.Timestamp(6)
  Cotizacion      Cotizacion @relation(fields: [cotizacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model CotizacionSeguimiento {
  id               String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  cotizacion_id    String
  fecha            DateTime?  @default(now()) @db.Timestamp(6)
  tipo             String
  descripcion      String
  realizado_por    String?
  proximo_contacto DateTime?  @db.Date
  created_at       DateTime?  @default(now()) @db.Timestamp(6)
  Cotizacion       Cotizacion @relation(fields: [cotizacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Usuario          User?      @relation(fields: [realizado_por], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

