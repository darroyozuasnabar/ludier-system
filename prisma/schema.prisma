generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerAccountId])
}

model Project {
  id                    String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                  String
  client                String
  clientType            String?                 @default("CONSTRUCTORA")
  valorization          Float
  status                String?                 @default("ACTIVO")
  startDate             DateTime                @db.Timestamp(6)
  expectedEndDate       DateTime                @db.Timestamp(6)
  actualEndDate         DateTime?               @db.Timestamp(6)
  location              String
  description           String?
  createdAt             DateTime?               @default(now()) @db.Timestamp(6)
  updatedAt             DateTime?               @default(now()) @db.Timestamp(6)
  Alert                 Alert[]
  ConfiguracionContrato ConfiguracionContrato[]
  Contrato              Contrato[]
  CostoReal             CostoReal[]
  Hito                  Hito[]
  Trabajo               Trabajo[]
  Valorizacion          Valorizacion[]
}

model Session {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamp(6)
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model User {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  email     String    @unique
  name      String?
  role      String?   @default("OPERATIVO")
  active    Boolean?  @default(true)
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
  Account   Account[]
  Session   Session[]
}

model Alert {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  projectId   String?
  title       String
  description String
  priority    String
  status      String?   @default("PENDIENTE")
  createdAt   DateTime? @default(now()) @db.Timestamp(6)
  Project     Project?  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ConfiguracionContrato {
  id                String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  project_id        String?
  nombre            String
  costo_directo     Decimal   @db.Decimal(12, 2)
  garantia          Decimal   @db.Decimal(12, 2)
  total_pagar       Decimal   @db.Decimal(12, 2)
  historico_cobrado Decimal?  @default(0) @db.Decimal(12, 2)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  Project           Project?  @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Contrato {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  project_id String?
  nombre     String
  monto      Decimal   @db.Decimal(12, 2)
  fecha      DateTime  @db.Date
  estado     String?   @default("ACTIVO")
  tipo       String?   @default("CONTRATO")
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  Project    Project?  @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model CostoReal {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  projectId      String
  descripcion    String
  fecha          DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  fierro         Decimal   @default(0) @db.Decimal(12, 2)
  pintura        Decimal   @default(0) @db.Decimal(12, 2)
  galvanizado    Decimal   @default(0) @db.Decimal(12, 2)
  manoObra       Decimal   @default(0) @db.Decimal(12, 2)
  transporte     Decimal   @default(0) @db.Decimal(12, 2)
  instalacion    Decimal   @default(0) @db.Decimal(12, 2)
  desperdicio    Decimal   @default(0) @db.Decimal(12, 2)
  retrabajos     Decimal   @default(0) @db.Decimal(12, 2)
  createdAt      DateTime? @default(now()) @db.Timestamp(6)
  contratoNombre String    @default("")
  Project        Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Hito {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  project_id  String?
  title       String
  description String
  fecha       String
  badge       String
  badge_color String
  acento      String
  orden       Int?      @default(0)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  Project     Project?  @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Inventario {
  id            String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  nombre        String
  categoria     String
  cantidad      Int             @default(0)
  ubicacion     String
  unidad        String?         @default("unidades")
  stock_minimo  Int?            @default(0)
  contenido     String?
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  updated_at    DateTime?       @default(now()) @db.Timestamp(6)
  Mantenimiento Mantenimiento[]
  Prestamo      Prestamo[]
}

model Mantenimiento {
  id           String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  item_id      String?
  item_nombre  String
  tipo         String
  descripcion  String?
  fecha        DateTime    @db.Date
  fechaproximo DateTime?   @db.Date
  costo        Decimal?    @db.Decimal(10, 2)
  created_at   DateTime?   @default(now()) @db.Timestamp(6)
  Inventario   Inventario? @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Prestamo {
  id                  String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  item_id             String?
  item_nombre         String
  trabajador          String
  fechaprestamo       DateTime    @db.Date
  fechadevolucion     DateTime?   @db.Date
  fechadevolucionreal DateTime?   @db.Date
  estado              String?     @default("ACTIVO")
  observaciones       String?
  created_at          DateTime?   @default(now()) @db.Timestamp(6)
  Inventario          Inventario? @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Trabajo {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  project_id String?
  name       String
  orden      Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  Project    Project?  @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Valorizacion {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  projectId    String?
  period       String
  costoDirecto Decimal   @db.Decimal(12, 2)
  igv          Decimal   @db.Decimal(12, 2)
  totalFactura Decimal   @db.Decimal(12, 2)
  garantia     Decimal   @db.Decimal(12, 2)
  netoCobrar   Decimal   @db.Decimal(12, 2)
  avancePct    Decimal   @db.Decimal(5, 2)
  status       String?   @default("PENDIENTE")
  fechaEmision DateTime  @db.Timestamp(6)
  fechaCobro   DateTime? @db.Timestamp(6)
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  notas        String?
  Project      Project?  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Worker {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  role      String
  location  String
  active    Boolean?  @default(true)
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
}

// ============================================================
// CRM — Módulo Contactos (Jhon · APF1)
// ============================================================
model CrmContacto {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  nombre       String    @db.VarChar(100)
  apellido     String    @db.VarChar(100)
  cargo        String?   @db.VarChar(100)
  empresa      String?   @db.VarChar(150)
  email        String?   @db.VarChar(150)
  telefono     String?   @db.VarChar(20)
  telefono_alt String?   @db.VarChar(20)
  direccion    String?   @db.VarChar(200)
  /// Estado del contacto: ACTIVO | INACTIVO | PROSPECTO
  estado       String    @default("ACTIVO") @db.VarChar(20)
  notas        String?
  creado_por   String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([empresa])
  @@index([email])
  @@index([estado])
  @@index([creado_por])
  @@map("CrmContacto")
}
